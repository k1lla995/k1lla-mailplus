# 前端环境变量示例文件
#
# 本文件仅作模板，不会被 Vite 直接加载。
# Vite 按 --mode 加载对应的文件，请复制本文件为下列名称后再修改：
#
#   cp .env.example .env.dev       # pnpm dev     （本地开发）
#   cp .env.example .env.release   # pnpm build   （发布构建，产物输出到 mail-worker/dist）
#   cp .env.example .env.remote    # pnpm remote  （连接远程后端调试）
#
# 这些 .env.* 文件已加入 .gitignore，不会提交到仓库。

# 运行环境标识（仅作记录，Vite 不会用其切换逻辑）
NODE_ENV = 'dev'

# 浏览器标签 / 应用标题
VITE_APP_TITLE = '开发环境'

# 后端 API 地址
#   dev    -> 本地 wrangler dev 地址，例如 'http://127.0.0.1:8787/api'
#   release-> 与 Worker 同域部署，固定为 '/api'
#   remote -> 已部署实例地址，例如 'https://example.com/api'
VITE_BASE_URL = 'http://127.0.0.1:8787/api'

# PWA 应用名称
VITE_PWA_NAME = 'k1lla-mailplus'

# 静态资源基础路径（可选，留空则使用 '/'）
# VITE_STATIC_URL = '/'

# 构建产物输出目录（仅 .env.release 需要）
# 发布构建必须输出到 ../mail-worker/dist，否则 wrangler 找不到静态资源
# VITE_OUT_DIR = ../mail-worker/dist
